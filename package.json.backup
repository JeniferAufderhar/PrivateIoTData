{
  "name": "private-iot-data",
  "version": "1.0.0",
  "description": "Secure IoT Data Management Platform with Privacy Protection",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.js --watch",
    "build": "node esbuild.config.js",
    "preview": "vite preview",
    "deploy:contract": "hardhat run scripts/deploy.js",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:vercel": "vercel",
    "verify": "hardhat run scripts/verify.js",
    "verify:sepolia": "hardhat run scripts/verify.js --network sepolia",
    "interact": "hardhat run scripts/interact.js",
    "interact:sepolia": "hardhat run scripts/interact.js --network sepolia",
    "simulate": "hardhat run scripts/simulate.js",
    "test": "hardhat test",
    "test:sepolia": "hardhat test --network sepolia",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "compile": "hardhat compile",
    "typechain": "hardhat typechain",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "lint:sol:fix": "solhint 'contracts/**/*.sol' --fix",
    "lint:js": "eslint '**/*.{js,ts,tsx}' --ignore-path .eslintignore",
    "lint:js:fix": "eslint '**/*.{js,ts,tsx}' --ignore-path .eslintignore --fix",
    "lint": "npm run lint:sol && npm run lint:js",
    "lint:fix": "npm run lint:sol:fix && npm run lint:js:fix",
    "format": "prettier --write '**/*.{sol,js,ts,tsx,json,md}'",
    "format:check": "prettier --check '**/*.{sol,js,ts,tsx,json,md}'",
    "size": "hardhat size-contracts",
    "security:check": "npm run lint:sol && npm run test",
    "audit": "npm run lint && npm run test:gas && npm run security:check",
    "clean": "hardhat clean && rm -rf cache artifacts types coverage dist",
    "prepare": "husky install",
    "prebuild": "npm run compile",
    "postinstall": "npm run prepare || true"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@rainbow-me/rainbowkit": "^2.1.0",
    "@tanstack/react-query": "^5.28.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1",
    "viem": "^2.7.0",
    "wagmi": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@fhevm/hardhat-plugin": "^0.0.1-6",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.8",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "chai": "^4.5.0",
    "chai-as-promised": "^8.0.1",
    "esbuild": "^0.20.1",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^8.57.0",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.0",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-deploy": "^0.11.45",
    "hardhat-gas-reporter": "^2.3.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "mocha": "^11.7.1",
    "postcss": "^8.4.35",
    "prettier": "^3.0.0",
    "prettier-plugin-solidity": "^1.1.3",
    "solhint": "^4.1.1",
    "solidity-coverage": "^0.8.16",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.8.3",
    "vite": "^5.1.3"
  },
  "keywords": [
    "iot",
    "privacy",
    "blockchain",
    "encryption",
    "react",
    "wagmi"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.sol": [
      "solhint --fix",
      "prettier --write"
    ],
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
