# ==================================================
# PRIVATE IOT DATA PLATFORM - ENVIRONMENT CONFIGURATION
# ==================================================

# ==================================================
# NETWORK CONFIGURATION
# ==================================================

# Sepolia Testnet Configuration
VITE_CHAIN_ID=11155111
VITE_NETWORK_NAME=sepolia

# RPC URLs
VITE_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
VITE_ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Fallback RPC
VITE_FALLBACK_RPC=https://rpc.sepolia.org

# ==================================================
# WEB3 WALLET CONFIGURATION
# ==================================================

# WalletConnect Project ID (Required)
# Get from: https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ==================================================
# SMART CONTRACT ADDRESSES
# ==================================================

# Main Contract Address (Update after deployment)
VITE_CONTRACT_ADDRESS=0xYourContractAddressHere

# Advanced Contract with Gateway Callbacks
VITE_ADVANCED_CONTRACT_ADDRESS=0xYourAdvancedContractAddressHere

# ==================================================
# GATEWAY CONFIGURATION
# ==================================================

# Gateway Address for Decryption Callbacks
VITE_GATEWAY_ADDRESS=0xYourGatewayAddressHere

# Gateway API Endpoint
VITE_GATEWAY_API_URL=https://gateway.example.com/api/v1

# Gateway Timeout (milliseconds)
VITE_GATEWAY_TIMEOUT=86400000

# ==================================================
# PAUSER CONFIGURATION
# ==================================================

# Pauser Address (for emergency pause)
VITE_PAUSER_ADDRESS=0xYourPauserAddressHere

# Emergency Contact
VITE_EMERGENCY_CONTACT=admin@yourproject.com

# ==================================================
# REFUND MECHANISM CONFIGURATION
# ==================================================

# Minimum Deposit for Gateway Callbacks (in ETH)
VITE_MIN_CALLBACK_DEPOSIT=0.001

# Refund Pool Reserve (in ETH)
VITE_REFUND_POOL_RESERVE=1.0

# Auto-refund enabled
VITE_AUTO_REFUND_ENABLED=true

# Refund timeout (hours)
VITE_REFUND_TIMEOUT_HOURS=24

# ==================================================
# PRIVACY & SECURITY CONFIGURATION
# ==================================================

# Enable Price Obfuscation
VITE_PRICE_OBFUSCATION_ENABLED=true

# Random Multiplier Range (min-max)
VITE_RANDOM_MULTIPLIER_MIN=1
VITE_RANDOM_MULTIPLIER_MAX=1000

# Enable Zero-Knowledge Proofs
VITE_ZKP_ENABLED=true

# Encryption Algorithm
VITE_ENCRYPTION_ALGORITHM=FHE

# ==================================================
# GAS OPTIMIZATION
# ==================================================

# Max Gas Price (Gwei)
VITE_MAX_GAS_PRICE=50

# Gas Price Strategy (slow|medium|fast)
VITE_GAS_PRICE_STRATEGY=medium

# Enable Gas Optimization
VITE_GAS_OPTIMIZATION=true

# HCU (Homomorphic Computation Unit) Limit
VITE_HCU_LIMIT=1000000

# ==================================================
# API KEYS & EXTERNAL SERVICES
# ==================================================

# Alchemy API Key
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Infura API Key
VITE_INFURA_API_KEY=your_infura_api_key_here

# Etherscan API Key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Block Explorer URL
VITE_BLOCK_EXPLORER=https://sepolia.etherscan.io

# ==================================================
# MONITORING & ANALYTICS
# ==================================================

# Enable Analytics
VITE_ANALYTICS_ENABLED=true

# Analytics Tracking ID
VITE_ANALYTICS_ID=your_analytics_id_here

# Error Reporting (Sentry DSN)
VITE_SENTRY_DSN=your_sentry_dsn_here

# Log Level (debug|info|warn|error)
VITE_LOG_LEVEL=info

# ==================================================
# RATE LIMITING & THROTTLING
# ==================================================

# Max Requests Per Minute
VITE_MAX_REQUESTS_PER_MINUTE=60

# Device Registration Limit Per User
VITE_MAX_DEVICES_PER_USER=100

# Data Submission Limit Per Device Per Hour
VITE_MAX_SUBMISSIONS_PER_HOUR=1000

# ==================================================
# TIMEOUT & RETRY CONFIGURATION
# ==================================================

# Transaction Timeout (milliseconds)
VITE_TX_TIMEOUT=300000

# Max Retry Attempts
VITE_MAX_RETRY_ATTEMPTS=3

# Retry Delay (milliseconds)
VITE_RETRY_DELAY=5000

# Callback Processing Timeout (hours)
VITE_CALLBACK_TIMEOUT_HOURS=24

# ==================================================
# IOT DEVICE CONFIGURATION
# ==================================================

# Supported Data Types
VITE_SUPPORTED_DATA_TYPES=temperature,humidity,pressure,motion,light,sound

# Max Device ID Length
VITE_MAX_DEVICE_ID_LENGTH=64

# Min Data Value
VITE_MIN_DATA_VALUE=0

# Max Data Value
VITE_MAX_DATA_VALUE=4294967295

# ==================================================
# THRESHOLD CONFIGURATION
# ==================================================

# Default Temperature Threshold (Celsius)
VITE_DEFAULT_TEMP_MIN=15
VITE_DEFAULT_TEMP_MAX=30

# Default Humidity Threshold (%)
VITE_DEFAULT_HUMIDITY_MIN=30
VITE_DEFAULT_HUMIDITY_MAX=70

# Default Pressure Threshold (hPa)
VITE_DEFAULT_PRESSURE_MIN=950
VITE_DEFAULT_PRESSURE_MAX=1050

# ==================================================
# UI/UX CONFIGURATION
# ==================================================

# Theme
VITE_THEME=system

# Toast Duration (milliseconds)
VITE_TOAST_DURATION=5000

# Enable Animations
VITE_ANIMATIONS_ENABLED=true

# Date Format
VITE_DATE_FORMAT=en-US

# ==================================================
# DEVELOPMENT CONFIGURATION
# ==================================================

# Development Mode
VITE_DEV_MODE=true

# Enable Debug Logging
VITE_DEBUG=false

# Mock Gateway Responses (for testing)
VITE_MOCK_GATEWAY=false

# Local Development RPC
VITE_LOCAL_RPC=http://localhost:8545

# ==================================================
# PRODUCTION CONFIGURATION
# ==================================================

# Production Mode
# VITE_PROD_MODE=true

# CDN URL
# VITE_CDN_URL=https://cdn.yourproject.com

# API Base URL
# VITE_API_BASE_URL=https://api.yourproject.com

# ==================================================
# DEPLOYMENT CONFIGURATION
# ==================================================

# Deployment Network
DEPLOYMENT_NETWORK=sepolia

# Deployer Private Key (NEVER COMMIT THIS!)
# DEPLOYER_PRIVATE_KEY=your_private_key_here

# Contract Verification
VERIFY_CONTRACT=true

# ==================================================
# BACKUP & RECOVERY
# ==================================================

# Backup Gateway Address
VITE_BACKUP_GATEWAY=0xBackupGatewayAddressHere

# Recovery Mode Enabled
VITE_RECOVERY_MODE=false

# ==================================================
# COMPLIANCE & AUDITING
# ==================================================

# Enable Audit Logging
VITE_AUDIT_LOGGING=true

# Audit Log Retention (days)
VITE_AUDIT_RETENTION_DAYS=90

# GDPR Compliance Mode
VITE_GDPR_ENABLED=true

# Data Retention Period (days)
VITE_DATA_RETENTION_DAYS=365

# ==================================================
# NOTIFICATION CONFIGURATION
# ==================================================

# Email Notifications
VITE_EMAIL_NOTIFICATIONS=true
VITE_NOTIFICATION_EMAIL=notifications@yourproject.com

# Webhook URL for Alerts
VITE_WEBHOOK_URL=https://hooks.yourproject.com/alerts

# Telegram Bot Token (for alerts)
# VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ==================================================
# FEATURE FLAGS
# ==================================================

# Enable Gateway Callback Pattern
VITE_FEATURE_GATEWAY_CALLBACK=true

# Enable Refund Mechanism
VITE_FEATURE_REFUND_MECHANISM=true

# Enable Timeout Protection
VITE_FEATURE_TIMEOUT_PROTECTION=true

# Enable Price Obfuscation
VITE_FEATURE_PRICE_OBFUSCATION=true

# Enable Advanced Security
VITE_FEATURE_ADVANCED_SECURITY=true

# Enable Transaction History
VITE_FEATURE_TRANSACTION_HISTORY=true

# ==================================================
# NOTES
# ==================================================
# 1. Never commit this file with real credentials
# 2. Copy this file to .env and fill in your values
# 3. Add .env to .gitignore
# 4. Update values after contract deployment
# 5. Use strong, unique values for production
# ==================================================
